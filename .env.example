# Optional local configuration. Defaults work without creating a .env file.
# Copy to .env in the repository root and keep that file out of Git.
# Docker Compose reads .env; npm run backend:dev and backend:test load it too.
# Shell environment variables take precedence over values from this file.
DATABASE_URL=jdbc:postgresql://localhost:5432/neon_void
DATABASE_USERNAME=neon_void
DATABASE_PASSWORD=neon_void
